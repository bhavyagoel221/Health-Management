	fetchPatientDetailsById: function(id){
		var patient = new GlideRecord('u_patient_table');
		patient.addQuery('u_number',id);
		patient.query();
		if (patient.next()){
			return patient;
		}
		else{
			return "NO Patient Found";
		}
	},

	checkIfPatientIsVip: function(id){
		var patient = new GlideRecord('u_patient_table');
		patient.addQuery('u_number',id);
		patient.query();
		if(patient.next()){
			gs.print(patient.u_vip)
		}
        return false
    },

    type: 'PatientUtils'
};
