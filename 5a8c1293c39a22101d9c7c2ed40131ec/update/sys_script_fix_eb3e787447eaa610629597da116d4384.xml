        <before>false</before>
        <description>A script to fetch all appointments for a specific patient.</description>
        <name>q1_fetch_appointments</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[// var patientId = '9f0d843847e6a610629597da116d433c';

var grApp = new GlideRecord('u_appointment');
grApp.addQuery('u_patient_id','0ec304b847a6a610629597da116d4372');
grApp.query();

while (grApp.next()) {
    var date = grApp.u_appointment_date.getDisplayValue();
    var doctor = grApp.u_doctor.getDisplayValue();
    var department = grApp.u_department.toString();
    var status = grApp.u_status.toString();

    gs.print(date + ' -- ' + doctor + ' -- ' + department + ' -- ' + status);
}
]]></script>
