        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

        var utils = new InsuranceUtils();
        var insurances = utils.getInsuranceByPatientID('8ec30c7c47a6a610629597da116d43a2');
        while (insurances.next()) {
            gs.print(insurances.getDisplayValue('u_policy_number') + ' - ' + insurances.u_coverage_details);
        }


        var isActive = utils.isPolicyActive('8ec30c7c47a6a610629597da116d43a2');
        gs.print(isActive ? 'Policy is active' : 'Policy is inactive');


        var _policyId = utils.getPolicyByID('7ed4d8f0472aa610629597da116d4372');
        if (_policyId) {

            gs.print(_policyId.u_policy_number.getDisplayValue() + ' - ' + _policyId.u_coverage_details);
        } else {
            gs.print("No Policy Found");
        }

        var policies = utils.getPoliciesByProvider('Bajaj Allianz');

        while (policies.next()) {
            gs.print(policies.getDisplayValue('u_policy_number') + " ----- " + policies.u_patient_id.getDisplayValue());
            }

})(current, previous);]]></script>
