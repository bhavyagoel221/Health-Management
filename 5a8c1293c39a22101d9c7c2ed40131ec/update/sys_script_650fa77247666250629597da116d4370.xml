        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var billing = new BillingUtils();

    var total = billing.getTotalBillingAmount('0ec304b847a6a610629597da116d4372');
    gs.print('Total Billing Amount: ₹' + total);


    var isOverdue = billing.isBillingOverdue('91ad747447eaa610629597da116d439d');
    if (!isOverdue) {
        gs.print('Bill is overdue')
    } else {
        gs.print('Bill is clear')
    }

    var bill = billing.getBillingByID('d9adf03447eaa610629597da116d434f');
    if (bill) {
        gs.print('Billing amount: ' + bill.u_total_amount);
        gs.print('appointment :' + bill.u_appointment_id.getDisplayValue())
    }


    var bills = billing.getBillingByPatientID('00d3407083662610e90ac955eeaad3ce');

    while (bills.next()) {
        gs.print('₹' + bills.u_total_amount + ' | Billing ID: ' + bills.number);
    }

})(current, previous);]]></script>
