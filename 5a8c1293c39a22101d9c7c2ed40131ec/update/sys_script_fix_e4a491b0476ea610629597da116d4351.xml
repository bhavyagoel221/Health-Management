<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description>A script to update the status of appointments that are overdue to "Cancelled".</description>
        <name>q2_update_status</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[var grApp = new GlideRecord('u_appointment');
grApp.addQuery('u_status','overdue');
grApp.query();
while (grApp.next()){
	grApp.u_status = 'cancelled';
	grApp.update();
}]]></script>
