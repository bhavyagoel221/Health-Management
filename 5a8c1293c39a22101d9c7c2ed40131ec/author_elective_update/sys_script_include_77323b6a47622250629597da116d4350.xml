        <script><![CDATA[var PatientUtils = Class.create();
PatientUtils.prototype = {
    initialize: function() {
    },
	fetchPatientDetailsById: function(id){
		var patient = new GlideRecord('u_patient_table');
		patient.addQuery('u_number',id);
		patient.query();
		if (patient.next()){
			return patient;
		}
		else{
			return "NO Patient Found";
		}
	},

    type: 'PatientUtils'
};]]></script>
