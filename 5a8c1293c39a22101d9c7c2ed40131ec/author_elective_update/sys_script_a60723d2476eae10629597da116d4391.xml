        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	
	if (current.u_assigned_to != previous.u_assigned_to){
		var ward = new GlideRecord('u_ward_table');
		var wardID = current.u_ward_id;
		ward.addQuery('sys_id', wardID);
		ward.query();
		if(ward.next()){
            gr.u_occupancy += 1;
            gs.addInfoMessage('occupancy updated in ward table to '+ ward.u_occupancy);
		}
    }
	
})(current, previous);]]></script>
